# X username to scrape
X_USERNAME=wifsimster

# Session tokens for web scraping — extract from browser cookies after login
# 1. Log in to x.com in your browser
# 2. Open DevTools → Application → Cookies → https://x.com
# 3. Copy the values of "auth_token" and "ct0"
X_SESSION_AUTH_TOKEN=
X_SESSION_CSRF_TOKEN=

# Optional: override GraphQL operation IDs when X changes them
# X_GQL_USER_BY_SCREEN_NAME_ID=qW5u-DAuXpMEG0zA1F7UGQ
# X_GQL_HOME_TIMELINE_ID=ulQKqowrFU94KfUAZqgGvg

# --- AI provider (ADR-0027) ----------------------------------------------------
# Two adapters behind one AI port. AI_PROVIDER picks one; when unset, Anthropic
# is used as soon as ANTHROPIC_API_KEY is set, otherwise GitHub Models.
# Rollback without a code change: AI_PROVIDER=github-models (keep GITHUB_TOKEN).
# AI_PROVIDER=anthropic
#
# Option A (recommended) — Anthropic API (official SDK). Key from
# https://platform.claude.com/settings/keys. Env only: never stored in the
# database nor returned by the API. An empty value counts as unset.
ANTHROPIC_API_KEY=
#
# Option B — GitHub Models, free. Fine-grained PAT with the `models:read`
# scope (https://github.com/settings/tokens). Also enables GitHub repo-context
# enrichment during content generation (with any provider).
GITHUB_TOKEN=
#
# Option C — OpenRouter (or any OpenAI-compatible provider), via the
# github-models adapter.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...

# Optional — model ids. Unset = provider default: claude-opus-5 (Anthropic) or
# openai/gpt-4.1 (GitHub Models). An id of the other provider's family is
# ignored with a warning, so switching AI_PROVIDER alone is always safe.
# AI_MODEL=claude-opus-5
# High-volume classification (hourly triage, radar scoring). Unset = AI_MODEL.
# Cheaper options: claude-sonnet-5, claude-haiku-4-5.
# AI_MODEL_FAST=claude-opus-5
# Monthly Anthropic budget in USD: warning at 80 % (logs + Discord + Settings),
# non-essential workflows stopped at 100 % (digest and triage keep running).
# AI_MONTHLY_BUDGET_USD=200
# TWEETS_LOOKBACK_DAYS=1
# Max accumulated items fed to the AI per digest. Bounds the prompt so a backlog
# can't blow past the provider's prompt-token limit and stall the digest.
# Newest items are summarized; the rest are still drained from the queue.
# VEILLE_DIGEST_MAX_ITEMS=300
# DRY_RUN=true
# CRON_SCHEDULE=30 7 * * *

# Back-office
# ADMIN_PASSWORD=your-secure-password
# WEB_PORT=3000

# Optional — Discord webhook URL for automatic summary notifications
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional — veille digest delivery. `per-product` (default) posts one message
# per product to its own webhook. `consolidated` posts ONE daily digest with a
# section per product (top 3 items or "Rien de notable"), split into as few
# messages as Discord limits allow. Consolidated mode posts to
# VEILLE_DISCORD_WEBHOOK_URL ONLY: when unset the post is skipped (warn log,
# runs.notification_status='skipped'); there is no fallback to
# DISCORD_WEBHOOK_URL nor to per-product webhooks. Both are also editable in
# Settings (DB overrides env).
# VEILLE_DIGEST_MODE=per-product
# VEILLE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional — Stripe secret key for the Facturation module. When unset, invoicing
# works as a local ledger and Stripe sync is a no-op. https://dashboard.stripe.com/apikeys
# STRIPE_API_KEY=sk_live_...

# Optional — Stripe publishable key. Required only to mount the embedded Checkout
# ("Encaisser" on an invoice); without it the action stays hidden.
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# Optional — calendar ICS feed URL for the Agenda module (e.g. Google Calendar
# "secret address in iCal format"). When unset, Agenda works as a local store.
# AGENDA_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Optional — Radar produit (ADR-0026): very relevant veille news become GitHub
# issue proposals in the product's repo (product URL = https://github.com/owner/repo).
# GITHUB_ISSUES_TOKEN is a DEDICATED fine-grained token (Repository access: only
# the product repos; Permissions: Issues = Read and write). It is distinct from
# GITHUB_TOKEN, which is never used to write. Unset = the radar stays in dry-run
# (proposals listed in Settings + Discord, no issue created). Env only.
# GITHUB_ISSUES_TOKEN=github_pat_...
# Toggle, dry-run, threshold and daily caps (also editable in Settings; DB overrides env).
# RADAR_ENABLED=false
# RADAR_DRY_RUN=true
# RADAR_SCORE_THRESHOLD=0.8
# RADAR_MAX_PER_PRODUCT_PER_DAY=1
# RADAR_MAX_PER_DAY=3

# Optional — custom SQLite database path (defaults to ./data/bot.db)
# DB_PATH=./data/bot.db

# Optional — route production veille through the workflow engine (the "flip",
# ADR-0020). Behaviour is identical; runs are also recorded in workflow_runs.
# Default (unset) keeps the legacy cron dispatch. Reversible by unsetting.
# WORKFLOW_SCHEDULER=true

# ---------------------------------------------------------------------------
# CLI client (optional) — these configure the `solopilot` CLI (HTTP API client
# for agents), NOT the server. Ignored by the server process; read by the CLI.
# ---------------------------------------------------------------------------
# Base URL the CLI targets (overridable with --url). Default http://localhost:3000
# SOLOPILOT_API_URL=https://your-host
# Admin password for the CLI's HTTP Basic auth (admin:<password>; overridable with
# --password). Falls back to ADMIN_PASSWORD if unset.
# SOLOPILOT_ADMIN_PASSWORD=your-secure-password
